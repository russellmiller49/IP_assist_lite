# IP Assist Lite / Medparse Integration

# Core Medparse configuration
MEDPARSE_ENABLED=true
MEDPARSE_TRANSPORT=http
MEDPARSE_BASE_URL=http://127.0.0.1:8099
MEDPARSE_API_KEY=
MEDPARSE_TIMEOUT_SECONDS=30
MEDPARSE_MAX_RETRIES=3
MEDPARSE_RETRY_BACKOFF_SECONDS=1

# Graph + vector storage
APP_USE_NEO4J=true
APP_USE_QDRANT=true
APP_SHOW_EVIDENCE=false

NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=ip
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Optional OpenAI configuration (application layer)
OPENAI_API_KEY=
IP_GPT5_MODEL=gpt-5-mini
