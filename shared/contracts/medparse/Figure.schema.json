{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "Figure.schema.json",
  "title": "Figure",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "label": {"type": ["string", "null"]},
    "caption": {"type": "string"},
    "page": {"type": "integer", "minimum": 1},
    "bbox_norm": {
      "type": "array",
      "items": {"type": "number", "minimum": 0.0, "maximum": 1.0},
      "minItems": 4,
      "maxItems": 4
    },
    "image_path": {"type": "string"},
    "evidence_spans": {
      "type": "array",
      "items": {"$ref": "EvidenceSpan.schema.json"},
      "minItems": 1
    }
  },
  "required": ["id", "caption", "page", "bbox_norm", "image_path", "evidence_spans"]
}
