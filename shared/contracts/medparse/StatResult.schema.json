{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "StatResult.schema.json",
  "title": "StatResult",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string"},
    "kind": {
      "type": "string"
    },
    "type": {"type": "string"},
    "value": {"type": ["number", "null"]},
    "unit": {"type": ["string", "null"]},
    "context": {"type": ["string", "null"]},
    "evidence_spans": {
      "type": "array",
      "items": {"$ref": "EvidenceSpan.schema.json"},
      "minItems": 1
    }
  },
  "required": ["id", "evidence_spans"],
  "allOf": [
    {
      "anyOf": [
        {"required": ["kind"]},
        {"required": ["type"]}
      ]
    }
  ]
}
