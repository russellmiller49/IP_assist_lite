{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "StatResult.schema.json",
  "title": "StatResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "kind": {
      "type": "string",
      "enum": [
        "sensitivity",
        "specificity",
        "ppv",
        "npv",
        "diagnostic_yield_strict",
        "sample_size",
        "prevalence"
      ]
    },
    "value": {"type": ["number", "null"]},
    "unit": {"type": ["string", "null"]},
    "context": {"type": ["string", "null"]},
    "evidence_spans": {
      "type": "array",
      "items": {"$ref": "EvidenceSpan.schema.json"},
      "minItems": 1
    }
  },
  "required": ["id", "kind", "evidence_spans"]
}
