{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "Table.schema.json",
  "title": "Table",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "label": {"type": ["string", "null"]},
    "caption": {"type": "string"},
    "page": {"type": "integer", "minimum": 1},
    "bbox_norm": {
      "type": "array",
      "items": {"type": "number", "minimum": 0.0, "maximum": 1.0},
      "minItems": 4,
      "maxItems": 4
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "row": {"type": "integer", "minimum": 0},
          "col": {"type": "integer", "minimum": 0},
          "text": {"type": "string"}
        },
        "required": ["row", "col", "text"]
      }
    },
    "html": {"type": ["string", "null"]},
    "csv": {"type": ["string", "null"]},
    "evidence_spans": {
      "type": "array",
      "items": {"$ref": "EvidenceSpan.schema.json"},
      "minItems": 1
    }
  },
  "required": ["id", "caption", "page", "bbox_norm", "evidence_spans"]
}
